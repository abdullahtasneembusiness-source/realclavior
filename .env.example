# Public URL of the app — used to build OAuth / magic-link redirect URLs.
# Local dev: http://localhost:3000 · Production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Identity Services client ID (public). Enables the "Continue with Google"
# button, which signs in on our own domain via signInWithIdToken. Leave unset to hide
# the button. This is the OAuth 2.0 Web client's ID; add your site + localhost to that
# client's Authorized JavaScript origins, and add the same client ID to Supabase's
# Google provider.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Service role key — only used server-side (invite linking, launch cron).
# Bypasses RLS, so it must never be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the daily launch cron (/api/cron/launches). Vercel Cron sends this
# as a Bearer token; the endpoint refuses to run without it. Use any long random string
# and set the same value in the Vercel project's environment variables.
CRON_SECRET=

# Set once AI playbook generation (Phase 2b) and feedback distiller (Phase 2d) are wired up
ANTHROPIC_API_KEY=

# Transactional email (invites in Phase 1; digests/alerts in Phase 6).
# Invites still create the membership row without this — the send just no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Clovior <onboarding@resend.dev>"

# Set in Phase 6 (Stripe billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
