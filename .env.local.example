# Public URL of the app — used to build OAuth / magic-link redirect URLs.
# Local dev: http://localhost:3000 · Production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — only used server-side (invite linking, cron edge functions).
# Bypasses RLS, so it must never be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Set once AI playbook generation (Phase 2b) and feedback distiller (Phase 2d) are wired up.
# Without ANTHROPIC_API_KEY these features degrade gracefully (manual paths still work).
ANTHROPIC_API_KEY=
# Optional: override the model, or point at a gateway/proxy instead of the public API.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Transactional email (invites in Phase 1; digests/alerts in Phase 6).
# Invites still create the membership row without this — the send just no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Clovior <onboarding@resend.dev>"

# Set in Phase 6 (Stripe billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
